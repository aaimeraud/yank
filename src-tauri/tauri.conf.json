{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yank",
  "version": "0.1.2",
  "identifier": "com.yank.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "bun run icon:mac"
  },
  "app": {
    "windows": [
      {
        "title": "Yank",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 25 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": { "Resources/Assets.car": "target/icon/Assets.car" }
    }
  }
}